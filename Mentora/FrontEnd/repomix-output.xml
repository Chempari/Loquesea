<file path="src/pages/auth/shared/auth-shared.css">
/* ============================================
   Auth Shared Styles
   Extraídos de index.css para Login y Register
   ============================================ */

/* --- Auth Page Layout --- */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  position: relative;
  background: linear-gradient(135deg, #f0f4ff 0%, #e8ecf8 100%);
  overflow: hidden;
}

.auth-page--slide-in-left {
  animation: authPageSlideInLeft 0.45s ease-out both, authPageFadeIn 0.45s ease-out both;
}

.auth-page--slide-in-right {
  animation: authPageSlideInRight 0.45s ease-out both, authPageFadeIn 0.45s ease-out both;
}

@keyframes authPageFadeIn {
  from {
    opacity: 0;
    transform: translateY(22px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes authPageSlideInLeft {
  from {
    opacity: 0;
    transform: translateX(-40px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes authPageSlideInRight {
  from {
    opacity: 0;
    transform: translateX(40px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes authCardPop {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* --- Auth Background & Triangles --- */
.auth-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 1;
  pointer-events: none;
  filter: blur(22px) saturate(1.05);
}

.auth-triangle {
  position: absolute;
  top: 0;
  left: 0;
  clip-path: polygon(50% 0%, 98% 16%, 82% 100%, 18% 88%, 0% 24%);
  box-shadow: 0 18px 48px rgba(6, 20, 12, 0.14);
  mix-blend-mode: screen;
  will-change: transform;
  opacity: 0.75;
  z-index: 1;
}

.auth-page--fast-motion .auth-triangle {
  filter: brightness(1.16);
}

/* --- Glass Card Container --- */
.login-wrapper {
  width: 100%;
  padding: 24px;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 10;
}

.glass-card {
  background: rgba(27, 46, 38, 0.82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24px;
  width: 100%;
  max-width: 440px;
  padding: 48px 40px;
  box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35);
  text-align: center;
  color: #ffffff;
  animation: authCardPop 0.45s ease-out both;
}

/* --- Login/Register Title --- */
.login-title {
  color: #ffffff;
  font-size: 36px;
  font-weight: 700;
  letter-spacing: -0.01em;
  margin-bottom: 36px;
}

/* --- Form Layout --- */
.login-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* --- Input Container & Inputs --- */
.input-container {
  position: relative;
  width: 100%;
}

.round-input,
.round-input:focus,
.round-input:active,
.round-input:disabled {
  transition: background-color 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease, color 0.25s ease;
}

.round-input {
  width: 100%;
  padding: 14px 48px 14px 20px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 30px;
  font-size: 14.5px;
  color: #ffffff;
