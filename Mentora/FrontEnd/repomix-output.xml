.curso-preview {
  background: var(--white);
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}

.curso-preview-header {
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
  padding: 32px 24px;
  text-align: center;
}

.curso-preview-header h1 {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 8px;
}

.curso-preview-meta {
  font-size: 14px;
  color: var(--text-light);
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

.curso-preview-body {
  padding: 32px 24px;
}

.curso-preview-info {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 32px;
}

@media (max-width: 640px) {
  .curso-preview-info {
    grid-template-columns: 1fr;
  }
}

.curso-preview-desc h2,
.curso-preview-sidebar h2 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 12px;
}

.curso-preview-desc p {
  font-size: 15px;
  color: var(--text-light);
  line-height: 1.7;
}

.curso-preview-sidebar {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 20px;
  height: fit-content;
}

.curso-preview-price {
  font-size: 32px;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16px;
}

.curso-preview-price.gratis {
  color: var(--success);
}

.curso-preview-instructor {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.curso-preview-instructor img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.curso-preview-instructor span {
  font-size: 14px;
  font-weight: 500;
}

.btn-inscribir {
  width: 100%;
  padding: 12px;
  background: var(--accent);
  color: var(--white);
  border: none;
  border-radius: var(--radius);
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-inscribir:hover {
  background: var(--accent-hover);
}

.btn-inscribir:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Temario */
.temario {
  margin-top: 32px;
}

.temario h2 {
  color: #ffffff;
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 16px;
}

.seccion-item {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 8px;
  overflow: hidden;
}

.seccion-header {
  padding: 12px 16px;
  background: var(--bg);
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
}

.seccion-header:hover {
  background: #e5e7eb;
}

.leccion-item {
  padding: 10px 16px 10px 32px;
  font-size: 14px;
  color: var(--text-light);
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--border);
}

.leccion-item.completada {
  color: var(--success);
}

.leccion-item .leccion-icon {
  font-size: 16px;
  flex-shrink: 0;
}

.leccion-item label {
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

/* Reseñas */
.resenas-section {
  margin-top: 32px;
}

.resenas-section h2 {
  color : var(--white);
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 16px;
}

.resena-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  margin-bottom: 12px;
}

.resena-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.resena-header img {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
}

.resena-header .resena-name {
  font-weight: 600;
  font-size: 14px;
}

.resena-header .resena-stars {
  font-size: 14px;
  margin-left: auto;
}

.resena-comentario {
  font-size: 14px;
  color: var(--text-light);
  line-height: 1.5;
}

.resena-form {
  margin-top: 24px;
  padding: 20px;
  background: var(--bg);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.resena-form h3 {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 16px;
}

.star-rating {
  display: flex;
  gap: 4px;
  margin-bottom: 12px;
}

.star-rating button {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: var(--border);
  padding: 0;
  transition: color 0.1s;
}

.star-rating button.filled {
  color: #f59e0b;
}

.btn-enviar {
  padding: 10px 20px;
  background: var(--accent);
  color: var(--white);
  border: none;
  border-radius: var(--radius);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-enviar:hover {
  background: var(--accent-hover);
}

.btn-enviar:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Curso form (crear/editar) */
.curso-form-page {
  max-width: 640px;
  margin: 0 auto;
}

.curso-form-card {
  background: var(--white);
  border-radius: 12px;
  padding: 32px;
  box-shadow: var(--shadow-lg);
}

.curso-form-card h1 {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 24px;
}

/* Secciones y lecciones manager */
.secciones-manager {
  margin-top: 24px;
}

.secciones-manager h2 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16px;
}

.seccion-group {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  margin-bottom: 12px;
}

.seccion-group h3 {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.leccion-row {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
  align-items: flex-start;
}

.leccion-row input {
  flex: 1;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 14px;
  font-family: var(--sans);
  outline: none;
}

.leccion-row input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}

.btn-sm {
  padding: 6px 12px;
  font-size: 13px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  background: var(--white);
  transition: background 0.2s;
}

.btn-sm:hover {
  background: var(--bg);
}

.btn-sm.danger {
  color: var(--error);
  border-color: var(--error);
}

.btn-sm.danger:hover {
  background: var(--error-bg);
}

.btn-outline {
  padding: 10px 20px;
  background: var(--white);
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-outline:hover {
  background: rgba(79, 70, 229, 0.05);
}

/* Switch para publicar */
.switch-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
}

.switch {
  position: relative;
  width: 44px;
  height: 24px;
  background: var(--border);
  border-radius: 12px;
  cursor: pointer;
  border: none;
  transition: background 0.2s;
}

.switch.on {
  background: var(--success);
}

.switch::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  background: var(--white);
  border-radius: 50%;
  transition: transform 0.2s;
}

.switch.on::after {
  transform: translateX(20px);
}

/* Misc */
.divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 24px 0;
}

.imagen-preview {
  width: 100%;
  max-height: 200px;
  object-fit: cover;
  border-radius: var(--radius);
  margin-top: 8px;
  border: 1px solid var(--border);
}

.calificacion-display {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 16px;
  font-weight: 600;
  color: #f59e0b;
  margin-bottom: 12px;
}

.calificacion-display .estrellas {
  font-size: 18px;
}
