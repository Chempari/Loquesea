/* =========================================
   Contenedor Principal (Efecto Glassmorphism)
   ========================================= */
.curso-preview {
  max-width: 1000px;
  margin: 40px auto;
  padding: 36px;
  display: flex;
  flex-direction: column;
  gap: 32px;
  /* Fondo oscuro translúcido con desenfoque */
  background: rgba(30, 46, 38, 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #e2e8f0; /* Texto claro para contraste */
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.curso-preview h1, .curso-preview h2, .curso-preview h3 {
  color: #ffffff;
  margin-top: 0;
  font-weight: 700;
}

/* =========================================
   Encabezado del Curso
   ========================================= */
.curso-preview-header {
  display: flex;
  flex-direction: column;
  gap: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 24px;
}

.curso-preview h1 {
  font-size: 32px;
  letter-spacing: -0.5px;
}

.curso-preview-meta {
  display: flex;
  gap: 16px;
  font-size: 14px;
  align-items: center;
}

.curso-preview-meta span {
  background: rgba(163, 190, 176, 0.15);
  padding: 6px 14px;
  border-radius: 20px;
  font-weight: 600;
  color: #bbf7d0; /* Un verde menta suave */
  border: 1px solid rgba(163, 190, 176, 0.2);
}

/* =========================================
   Cuerpo y Layout Principal
   ========================================= */
.curso-preview-body {
  display: flex;
  gap: 32px;
}

.curso-preview-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 32px; /* Espacio entre descripción, temario y reseñas */
}

.curso-preview-desc p {
  color: #cbd5e1;
  line-height: 1.7;
  font-size: 16px;
}

/* =========================================
   Panel Lateral (Sidebar)
   ========================================= */
.curso-preview-sidebar {
  width: 320px;
  background: rgba(163, 190, 176, 0.08);
  border: 1px solid rgba(163, 190, 176, 0.15);
  border-radius: 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  align-items: center;
  height: fit-content;
  position: sticky;
  top: 24px; /* Hace que el panel acompañe al hacer scroll */
}

.curso-preview-price {
  font-size: 32px;
  font-weight: 800;
  color: #ffffff;
  padding: 16px 24px;
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.2);
  width: 100%;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.curso-preview-instructor {
  display: flex;
  gap: 14px;
  align-items: center;
  width: 100%;
  padding: 12px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  color: #e2e8f0;
  font-weight: 500;
}

.curso-preview-instructor img {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(163, 190, 176, 0.5);
}

.perfil-photo-placeholder {
  background: #4f6b5b;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: bold;
}

/* =========================================
   Botones Globales (Inscribir y Enviar)
   ========================================= */
.btn-inscribir, .btn-enviar {
  width: 100%;
  padding: 14px 20px;
  border-radius: 12px;
  background: #4f6b5b; /* Verde corporativo */
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: center;
  box-shadow: 0 4px 12px rgba(79, 107, 91, 0.3);
}

.btn-inscribir:hover, .btn-enviar:hover {
  background: #5e7e6c;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(79, 107, 91, 0.4);
}

.btn-inscribir:disabled, .btn-enviar:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* =========================================
   Temario (Acordeón)
   ========================================= */
.temario {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.seccion-item {
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.2s ease;
}

.seccion-header {
  display: flex;
  justify-content: space-between;
  padding: 16px 20px;
  cursor: pointer;
  font-weight: 600;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.02);
  transition: background 0.2s;
}

.seccion-header:hover {
