<file path="src/temp/styles.css">
/* PALETA DE COLOR: Gradación fluida desde el Verde Apagado Profundo hasta el Blanco Puro */
:root {
    --verde-apagado-oscuro: #1b2e26;    /* Base principal y textos dominantes */
    --verde-apagado-medio:  #345446;    /* Bordes con carácter, tags y elementos activos */
    --verde-apagado-suave:  #507a67;    /* Detalles secundarios y placeholders sutiles */
    --verde-intermedio-luz: #a3beb0;    /* Fondos limpios de componentes / estados hover */
    --verde-casi-blanco:    #e8f0ec;    /* Fondo de la interfaz, aporta luz sin ser blanco puro */
    --blanco-puro:          #ffffff;    /* Superficies de tarjetas y secciones aisladas */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: var(--verde-casi-blanco);
    color: var(--verde-apagado-oscuro);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    -webkit-font-smoothing: antialiased;
}

/* NAVBAR DISEÑADA */
.navbar {
    background-color: var(--blanco-puro);
    border-bottom: 1px solid var(--verde-intermedio-luz);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 18px 24px;
}

.navbar-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.logo {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--verde-apagado-oscuro);
}

.search-container {
    position: relative;
    max-width: 480px;
    width: 100%;
}

.search-input {
    width: 100%;
    padding: 10px 40px 10px 16px;
    background: var(--verde-casi-blanco);
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--verde-apagado-oscuro);
    outline: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.search-input:focus {
    border-color: var(--verde-apagado-medio);
    background: var(--blanco-puro);
    box-shadow: 0 0 0 3px rgba(52, 84, 70, 0.1);
}

.search-icon {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--verde-apagado-suave);
    display: flex;
    align-items: center;
}

.auth-buttons {
    display: flex;
    align-items: center;
    gap: 20px;
}

.btn-login {
    background: none;
    border: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--verde-apagado-medio);
    cursor: pointer;
    transition: color 0.2s ease;
}

.btn-login:hover {
    color: var(--verde-apagado-oscuro);
}

.btn-register {
    background-color: var(--verde-apagado-oscuro);
    color: var(--blanco-puro);
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-register:hover {
    background-color: var(--verde-apagado-medio);
    transform: translateY(-1px);
}

.btn-register:active {
    transform: translateY(0);
}

/* MAIN CONTENT */
.main-content {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 48px 24px;
    flex-grow: 1;
}

.header-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--verde-intermedio-luz);
    padding-bottom: 32px;
}

@media (min-width: 768px) {
    .header-section {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
    }
}

.main-title {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--verde-apagado-oscuro);
}

.subtitle {
    font-size: 14px;
    color: var(--verde-apagado-suave);
    margin-top: 4px;
}

/* FILTROS CON GRADACIÓN DE COLORES */
.filters-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.dropdown {
    position: relative;
}

.dropdown-btn {
    background: var(--blanco-puro);
    border: 1px solid var(--verde-intermedio-luz);
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--verde-apagado-oscuro);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 170px;
    justify-content: space-between;
    transition: all 0.25s ease;
}

.dropdown-btn:hover {
    border-color: var(--verde-apagado-suave);
    background-color: var(--verde-casi-blanco);
}

.filter-val {
    color: var(--verde-apagado-medio);
    font-weight: 600;
}

.arrow {
    display: flex;
    align-items: center;
    color: var(--verde-apagado-suave);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.dropdown-menu {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 6px;
    background-color: var(--blanco-puro);
    border: 1px solid var(--verde-intermedio-luz);
    border-radius: 8px;
    box-shadow: 0 12px 30px rgba(27, 46, 38, 0.08);
    width: 100%;
    min-width: 190px;
    z-index: 90;
    overflow: hidden;
    
    /* Animación fluida */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.dropdown-menu a {
    display: block;
    padding: 11px 16px;
    font-size: 13px;
    color: var(--verde-apagado-oscuro);
    text-decoration: none;
    transition: all 0.15s ease;
}

.dropdown-menu a:hover {
    background-color: var(--verde-casi-blanco);
    color: var(--verde-apagado-medio);
}

.dropdown-menu a.active-item {
    background-color: var(--verde-casi-blanco);
    font-weight: 600;
    color: var(--verde-apagado-oscuro);
}

.dropdown.active .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.dropdown.active .arrow {
    transform: rotate(180deg);
    color: var(--verde-apagado-oscuro);
}

/* REJILLA DE TARJETAS LLENA (COBERTURA COMPLETA) */
.courses-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
}

@media (min-width: 600px) {
    .courses-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 900px) {
    .courses-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 1200px) {
    .courses-grid { grid-template-columns: repeat(4, 1fr); }
}

.course-card {
    background-color: var(--blanco-puro);
    border: 1px solid var(--verde-intermedio-luz);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.course-card:hover {
    border-color: var(--verde-apagado-suave);
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(27, 46, 38, 0.05);
}

.card-image-container {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
}

.card-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--verde-intermedio-luz) 0%, var(--verde-casi-blanco) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--verde-apagado-medio);
    transition: all 0.4s ease;
}

.course-card:hover .card-image-placeholder {
    transform: scale(1.03);
    background: linear-gradient(135deg, var(--verde-apagado-suave) 0%, var(--verde-intermedio-luz) 100%);
    color: var(--blanco-puro);
}

.tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    color: var(--verde-apagado-oscuro);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--verde-intermedio-luz);
}

.card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
}

.card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--verde-apagado-oscuro);
    line-height: 1.4;
}

.card-description {
    font-size: 12.5px;
    color: var(--verde-apagado-suave);
    line-height: 1.5;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--verde-casi-blanco);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.level {
    font-size: 11px;
    font-weight: 500;
    background-color: var(--verde-casi-blanco);
    color: var(--verde-apagado-medio);
    padding: 2px 8px;
    border-radius: 4px;
}

.price {
    font-size: 14px;
    font-weight: 700;
    color: var(--verde-apagado-oscuro);
}

/* FOOTER */
.footer {
    border-top: 1px solid var(--verde-intermedio-luz);
    background-color: var(--blanco-puro);
    padding: 24px;
    text-align: center;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--verde-apagado-suave);
}
</file>

